# Nuxt server-side proxy target for the V2 backend. Keep browser calls on /v1
# so SIWE cookies and Origin checks remain same-origin.
NUXT_BACKEND_ORIGIN=http://127.0.0.1:3001

# Nuxt server-side proxy target for the tracking SSE realtime process (separate
# from the main backend, see server/middleware/tracking-events-proxy.ts).
NUXT_REALTIME_ORIGIN=http://127.0.0.1:3002

# Normally leave unset. Set only when the browser must call an already
# same-site V2 gateway directly; the value must include the /v1 prefix.
# NUXT_PUBLIC_API_BASE=https://example.com/v1
