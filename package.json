{
  "name": "monad-workspace",
  "private": true,
  "scripts": {
    "local:deploy": "node backend/scripts/local-deploy.mjs && node contracts/tools/build-exports.mjs && npm --prefix backend run build",
    "local:seed": "node backend/scripts/local-seed.mjs",
    "local:verify": "node backend/scripts/local-verify.mjs",
    "local:backend": "node backend/scripts/local-run.mjs backend",
    "local:frontend": "node backend/scripts/local-run.mjs frontend",
    "local:indexer": "node backend/scripts/local-run.mjs indexer",
    "local:quotes": "node backend/scripts/local-run.mjs quotes",
    "local:realtime": "node backend/scripts/local-run.mjs realtime",
    "local:migrate": "node backend/scripts/local-run.mjs migrate",
    "local:chain": "anvil --host 127.0.0.1 --port 8545 --chain-id 31337 --block-time 1 --code-size-limit 131072 --state /tmp/monosfer-anvil-state.json --silent",
    "chain": "anvil --host 127.0.0.1 --port 8545 --chain-id 31337",
    "deploy": "npm run contracts:build && node scripts/deploy-local.mjs",
    "deploy:monad-testnet": "node scripts/deploy-monad-testnet.mjs",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test --offline",
    "test:deploy": "node --test scripts/deploy-record.test.mjs",
    "frontend": "cd frontend && npm run dev",
    "backend": "cd backend && npm run dev",
    "start": "sh -c 'trap \"kill 0\" EXIT; (cd backend && npm run dev) & (cd frontend && npm run dev) & wait'",
    "contracts:exports": "cd contracts && forge build && node tools/build-exports.mjs",
    "contracts:exports:check": "cd contracts && forge build && node tools/build-exports.mjs --check"
  }
}
