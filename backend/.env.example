PORT=3001
HOST=127.0.0.1
NODE_ENV=development
DATABASE_URL=postgresql://monosfer:local-development-only@127.0.0.1:55432/monosfer_v2
REDIS_URL=redis://:local-development-only@127.0.0.1:56379
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
BODY_LIMIT_BYTES=65536
CONNECTION_TIMEOUT_MS=2000
SIWE_DOMAIN=localhost:3000
SIWE_URI=http://localhost:3000
SIWE_CHAIN_ID=10143
SIWE_STATEMENT=Sign in to Monosfer.
SIWE_RPC_URL=https://testnet-rpc.monad.xyz
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_COOKIE_SECRET=
SESSION_TTL_SECONDS=86400
NONCE_TTL_SECONDS=300
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=60
# Generate a separate key locally; persist securely and back up alongside encrypted data.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
PRIVATE_DATA_MASTER_KEY_B64=
PRIVATE_DATA_KEY_ID=local-v1
# CLI only. Use a Mongo account with read role on exactly this database.
LEGACY_MONGODB_URI=mongodb://127.0.0.1:57017
LEGACY_MONGODB_DATABASE=monosfer_legacy_test
LEGACY_MONGODB_READ_PREFERENCE=secondaryPreferred
# Stable unique source label; keep unchanged across credentials/host changes and reruns.
LEGACY_MONGODB_SOURCE_ID=local-legacy
# API reads projections; worker is started separately with npm run indexer -- watch.
INDEXER_ENABLED=false
INDEXER_CHAIN_ID=10143
INDEXER_RPC_URL=
INDEXER_BATCH_SIZE=100
INDEXER_POLL_MS=2000
INDEXER_MAX_LAG_BLOCKS=20
INDEXER_STALE_SECONDS=30
INDEXER_REORG_DEPTH=64
# Phase 5: dev/test only. Empty signer disables issuance; never use a funded wallet key.
# The signer must match ProtocolConfig.riskQuoteSigner on the configured test chain.
QUOTE_SIGNER_PRIVATE_KEY=
QUOTE_TTL_SECONDS=300
QUOTE_IDEMPOTENCY_TTL_SECONDS=86400
QUOTE_LINK_WORKER_ENABLED=false
QUOTE_LINK_WORKER_POLL_MS=2000
RISK_ADAPTER_MODE=deterministic
# Phase 6: local/dev/test adapters only; production provider/retention decisions pending.
OPERATIONS_ENABLED=false
TRACKING_SESSION_TTL_SECONDS=300
TRACKING_LOCATION_TTL_SECONDS=60
TRACKING_EVENT_TTL_SECONDS=180
TRACKING_POLL_MS=1000
TRACKING_STREAM_SECONDS=60
TRACKING_MAX_CONNECTIONS=100
REALTIME_PORT=3002
ROUTE_CACHE_TTL_SECONDS=30
PROVIDER_WORKER_ENABLED=false
PROVIDER_WORKER_POLL_MS=2000
PROVIDER_TIMEOUT_MS=1000
PROVIDER_MAX_ATTEMPTS=3
# Phase 7: support requires SIWE AND an explicit privileged allowlist.
SUPPORT_ENABLED=false
SUPPORT_WALLETS=
ADMIN_WALLETS=
SUPPORT_CASE_IDEMPOTENCY_TTL_SECONDS=86400
# Generate a separate 32+ character random token; blank disables bearer ops access.
OPS_METRICS_TOKEN=
# Default off until trace retention is agreed. Range 0..1.
OPS_TRACE_SAMPLE_RATE=0
# Local fixture target only; not a production RTO commitment.
OPS_RESTORE_DRILL_TARGET_SECONDS=60
TESTNET_SMOKE_RPC_URL=
## Contract-sync proofs: use a separate PoD signer; empty means attestation unavailable.
POD_ATTESTATION_SIGNER_PRIVATE_KEY=
POD_ATTESTATION_TTL_SECONDS=300
PROOF_ACCEPTANCE_TTL_SECONDS=300
PROOF_IDEMPOTENCY_TTL_SECONDS=86400
